# ─── Supabase ────────────────────────────────────────────────────
# Proyecto: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo servidor. NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── IA — proveedor principal (variables OPENAI_*) ────────────────
# LicitIA es multi-proveedor: cada documento se analiza con el motor que
# el usuario elige en la interfaz (Gemini, Groq o "Sin IA"). Este bloque
# es el proveedor "principal" (slot OPENAI_*) y admite cualquier API
# compatible con OpenAI. Todas las variables son opcionales — si se
# omiten, ese proveedor simplemente no aparece como opción en la interfaz.
#
# Opción A: OpenAI real (pagada, mejor calidad y la única con Files API
# probada 100% para OCR de PDFs escaneados):
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-5.1
OPENAI_FAST_MODEL=gpt-5.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
#
# Opción B: Google Gemini (GRATUITA, sin tarjeta) — la que usa este slot
# por defecto en este proyecto. Clave en https://aistudio.google.com →
# "Get API key". Combinación verificada contra la API real (chat,
# streaming, embeddings a 1536 dimensiones, salidas estructuradas con
# campos nulos y listas anidadas, y OCR vía Files API):
# OPENAI_API_KEY=AQ....            # las claves nuevas de AI Studio usan prefijo AQ.
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_CHAT_MODEL=gemini-3.6-flash
# OPENAI_FAST_MODEL=gemini-3.5-flash-lite
# OPENAI_EMBEDDING_MODEL=gemini-embedding-001
# OPENAI_EMBEDDING_DIMENSIONS=1536
# Ojo: gemini-2.5-flash ya no se habilita para cuentas nuevas; usa los de
# arriba. Limitaciones del plan gratuito: cuotas por minuto/día, y Google
# puede usar los datos del nivel gratuito para mejorar sus modelos —
# evalúalo para documentos sensibles.

# ─── IA — segundo proveedor (Groq, GRATUITA, sin tarjeta) ─────────
# Segundo motor independiente para cuando se agota la cuota del proveedor
# principal, o simplemente porque el usuario prefiere elegirlo. Clave en
# https://console.groq.com/keys. Inferencia muy rápida y nivel gratuito
# generoso; sin embeddings ni OCR de escaneados (ver docs/arquitectura.md).
# GROQ_API_KEY=gsk_...
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Importante: el modo estricto de Structured Outputs de Groq (garantiza
# JSON válido) SOLO lo soportan los modelos gpt-oss — cualquier otro
# modelo (p. ej. llama-3.3-70b-versatile) responde 400 "This model does
# not support response format json_schema". structuredCompletion() sabe
# degradar a modo JSON simple + validación propia si aun así se configura
# un modelo sin ese soporte, pero conviene usar los que sí lo soportan:
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b

# ─── IA — tercer proveedor: Claude (Anthropic) ─────────────────────────────
# A diferencia de los anteriores, Claude se usa con su SDK oficial
# (@anthropic-ai/sdk), no con la capa compatible con OpenAI: su API tiene otra
# forma y adaptarla solo escondería las diferencias (ver lib/anthropic.ts).
# Disponible en TODO análisis del sistema —subida/reprocesamiento de
# documentos, comparador, reclamos y Chat IA— como una opción más del
# selector de motor; nunca se elige automáticamente en modo "Automático",
# que solo encadena proveedores gratuitos.
# Es de PAGO (no tiene nivel gratuito): se cobra por uso desde el primer
# token. Haiku 4.5 —el modelo más económico de la familia— es el
# predeterminado. Clave en https://console.anthropic.com → API Keys.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_CHAT_MODEL=claude-haiku-4-5

# ─── Neon (migración desde Supabase) ───────────────────────────────
# Ambas vacías: la app funciona 100% sobre Supabase, sin cambio de
# comportamiento (estado antes de la migración). Para activar Neon hace
# falta poner las TRES: sin alguna, queda en un estado a medias.
#
# Cadena de conexión del rol `app_user` (neon/00_compat_auth.sql), NUNCA
# la del dueño de las tablas: el dueño está exento de sus propias
# políticas RLS.
# DATABASE_URL=postgresql://app_user:...@...neon.tech/licitia?sslmode=require
# Firma las sesiones de better-auth (fase 3). Cualquier cadena aleatoria
# larga: `openssl rand -base64 32`.
# BETTER_AUTH_SECRET=...
# Espejo, para el navegador, de que DATABASE_URL está puesta: decide si
# login/logout usan better-auth o Supabase Auth (lib/supabase/client.ts).
# NEXT_PUBLIC_USE_NEON=1
#
# Fase 4 (archivos): vacía, los documentos y adjuntos siguen en Supabase
# Storage. Con ella puesta, van a Vercel Blob (privados; se sirven a través
# de la propia app, ver lib/storage.ts). Se crea sola al conectar un Blob
# Store al proyecto en Vercel — junto con BLOB_WEBHOOK_PUBLIC_KEY, que no
# usa este código. La app se autentica con el token OIDC de cada ejecución
# (automático en Vercel; no hace falta copiarlo a mano), así que no hay un
# BLOB_READ_WRITE_TOKEN que traer con `vercel env pull` para local — para
# probar esto en la máquina local hace falta `vercel dev` (proxya el OIDC
# real) o exportar un BLOB_READ_WRITE_TOKEN propio desde el dashboard.
# BLOB_STORE_ID=store_...

# ─── Aplicación ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secreto interno para invocar el pipeline de procesamiento en background.
INTERNAL_API_SECRET=cambia-esto-por-un-uuid-aleatorio

# ─── Límites ─────────────────────────────────────────────────────
MAX_UPLOAD_MB=50
