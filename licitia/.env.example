# ─── Supabase ────────────────────────────────────────────────────
# Proyecto: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo servidor. NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── OpenAI ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Modelo de razonamiento/chat (GPT-5.x). Ajustable sin tocar código.
OPENAI_CHAT_MODEL=gpt-5.1
# Modelo económico para clasificación / extracción masiva.
OPENAI_FAST_MODEL=gpt-5.1-mini
# Modelo de embeddings (1536 dims — debe coincidir con la migración SQL).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Aplicación ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secreto interno para invocar el pipeline de procesamiento en background.
INTERNAL_API_SECRET=cambia-esto-por-un-uuid-aleatorio

# ─── Límites ─────────────────────────────────────────────────────
MAX_UPLOAD_MB=50
