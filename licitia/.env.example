# ─── Supabase ────────────────────────────────────────────────────
# Proyecto: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo servidor. NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── IA — proveedor principal (variables OPENAI_*) ────────────────
# LicitIA es multi-proveedor: cada documento se analiza con el motor que
# el usuario elige en la interfaz (Gemini, Groq o "Sin IA"). Este bloque
# es el proveedor "principal" (slot OPENAI_*) y admite cualquier API
# compatible con OpenAI. Todas las variables son opcionales — si se
# omiten, ese proveedor simplemente no aparece como opción en la interfaz.
#
# Opción A: OpenAI real (pagada, mejor calidad y la única con Files API
# probada 100% para OCR de PDFs escaneados):
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-5.1
OPENAI_FAST_MODEL=gpt-5.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
#
# Opción B: Google Gemini (GRATUITA, sin tarjeta) — la que usa este slot
# por defecto en este proyecto. Clave en https://aistudio.google.com →
# "Get API key". Combinación verificada contra la API real (chat,
# streaming, embeddings a 1536 dimensiones, salidas estructuradas con
# campos nulos y listas anidadas, y OCR vía Files API):
# OPENAI_API_KEY=AQ....            # las claves nuevas de AI Studio usan prefijo AQ.
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_CHAT_MODEL=gemini-3.6-flash
# OPENAI_FAST_MODEL=gemini-3.5-flash-lite
# OPENAI_EMBEDDING_MODEL=gemini-embedding-001
# OPENAI_EMBEDDING_DIMENSIONS=1536
# Ojo: gemini-2.5-flash ya no se habilita para cuentas nuevas; usa los de
# arriba. Limitaciones del plan gratuito: cuotas por minuto/día, y Google
# puede usar los datos del nivel gratuito para mejorar sus modelos —
# evalúalo para documentos sensibles.

# ─── IA — segundo proveedor (Groq, GRATUITA, sin tarjeta) ─────────
# Segundo motor independiente para cuando se agota la cuota del proveedor
# principal, o simplemente porque el usuario prefiere elegirlo. Clave en
# https://console.groq.com/keys. Inferencia muy rápida y nivel gratuito
# generoso; sin embeddings ni OCR de escaneados (ver docs/arquitectura.md).
# No pude verificar esta combinación contra la API real desde este entorno
# (host bloqueado); valídala con un documento de prueba al configurarla.
# GROQ_API_KEY=gsk_...
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# GROQ_FAST_MODEL=llama-3.1-8b-instant

# ─── Aplicación ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secreto interno para invocar el pipeline de procesamiento en background.
INTERNAL_API_SECRET=cambia-esto-por-un-uuid-aleatorio

# ─── Límites ─────────────────────────────────────────────────────
MAX_UPLOAD_MB=50
