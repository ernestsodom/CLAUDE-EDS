# ─── Supabase ────────────────────────────────────────────────────
# Proyecto: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo servidor. NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── IA (opción A: OpenAI, pagada — recomendada para producción) ─
OPENAI_API_KEY=sk-...
# Modelo de razonamiento/chat (GPT-5.x). Ajustable sin tocar código.
OPENAI_CHAT_MODEL=gpt-5.1
# Modelo económico para clasificación / extracción masiva.
OPENAI_FAST_MODEL=gpt-5.1-mini
# Modelo de embeddings (1536 dims — debe coincidir con la migración SQL).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── IA (opción B: Google Gemini, GRATUITA — para partir sin costo) ─
# Clave gratis y sin tarjeta en https://aistudio.google.com → "Get API key".
# Combinación verificada contra la API (chat, streaming, embeddings a 1536
# dimensiones y salidas estructuradas con campos nulos y listas anidadas):
# OPENAI_API_KEY=AQ....            # las claves nuevas de AI Studio usan prefijo AQ.
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_CHAT_MODEL=gemini-3.6-flash
# OPENAI_FAST_MODEL=gemini-3.5-flash-lite
# OPENAI_EMBEDDING_MODEL=gemini-embedding-001
# OPENAI_EMBEDDING_DIMENSIONS=1536
# Ojo: gemini-2.5-flash ya no se habilita para cuentas nuevas; usa los de
# arriba. Limitaciones del plan gratuito: cuotas por minuto/día, sin OCR de
# PDFs escaneados (requiere OpenAI), y Google puede usar los datos del nivel
# gratuito para mejorar sus modelos — evalúalo para documentos sensibles.

# ─── Aplicación ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secreto interno para invocar el pipeline de procesamiento en background.
INTERNAL_API_SECRET=cambia-esto-por-un-uuid-aleatorio

# ─── Límites ─────────────────────────────────────────────────────
MAX_UPLOAD_MB=50
