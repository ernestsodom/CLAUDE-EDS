# =====================================================================
# PADEL BUSINESS MANAGEMENT PLATFORM
# Copiar a .env.local y completar. NUNCA commitear .env.local.
# =====================================================================

# --- Supabase (publicas: viajan al navegador) ------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Supabase (SECRETA: solo server-side) ----------------------------
# Bypasea RLS. Se usa unicamente en Server Actions, jobs y generacion de
# signed URLs. Si aparece en un bundle de cliente, es un incidente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- IA (solo server-side) -------------------------------------------
AI_PROVIDER=anthropic
AI_PROVIDER_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-5

# --- Aplicacion -------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_TIMEZONE=Europe/Madrid
DEFAULT_CURRENCY=EUR

# --- Motor de alertas -------------------------------------------------
# Token compartido para el endpoint que dispara app.generate_alerts()
ALERTS_CRON_SECRET=cambiar-por-un-valor-aleatorio-largo
