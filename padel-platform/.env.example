# =====================================================================
# PADEL BUSINESS MANAGEMENT PLATFORM
# Copiar a .env.local y completar. NUNCA commitear .env.local.
# =====================================================================

# --- Supabase (publicas: viajan al navegador) ------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Supabase (SECRETA: solo server-side) ----------------------------
# Bypasea RLS. Se usa unicamente en Server Actions, jobs y generacion de
# signed URLs. Si aparece en un bundle de cliente, es un incidente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- IA (solo server-side) -------------------------------------------
# Opcional: sin esta clave la aplicacion funciona entera y solo quedan
# inactivas la extraccion documental y el asistente.
AI_PROVIDER=anthropic
AI_PROVIDER_API_KEY=sk-ant-...

# --- Aplicacion -------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_TIMEZONE=Europe/Madrid
DEFAULT_CURRENCY=EUR

# --- Motor de alertas (FASE 15) ---------------------------------------
# Token compartido para /api/cron/alerts, que dispara app.generate_alerts()
# via public.run_generate_alerts(). Llamalo cada hora desde Vercel Cron
# (vercel.json) o desde .github/workflows/alerts-cron.yml.
#
# Si despliegas en Vercel y quieres que inyecte la cabecera Authorization
# automaticamente, usa el nombre reservado CRON_SECRET en su lugar (o
# ademas): el endpoint acepta cualquiera de los dos.
ALERTS_CRON_SECRET=cambiar-por-un-valor-aleatorio-largo

# --- Healthcheck / backups (FASE 15) -----------------------------------
# No hace falta variable nueva: /api/health y scripts/backup.sh reusan
# SUPABASE_SERVICE_ROLE_KEY y la connection string de Supabase
# (Settings > Database) respectivamente.
