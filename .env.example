# ─── Meta / Instagram ───────────────────────────────────────────
# Obtén estos valores en: https://developers.facebook.com/apps/
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_ig_business_account_id
INSTAGRAM_APP_ID=your_meta_app_id
INSTAGRAM_APP_SECRET=your_meta_app_secret

# ─── Anthropic / Claude ─────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Unsplash (búsqueda automática de imágenes) ─────────────────
# Gratis en: https://unsplash.com/developers (crea una app y copia el "Access Key")
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# ─── Comportamiento del bot ──────────────────────────────────────
# Cuántos posts por día (recomendado: 1-3)
DEFAULT_POST_FREQUENCY=2

# Nicho de tu marca (fitness|food|fashion|tech|lifestyle|beauty|travel|business|health|pets)
BRAND_NICHE=fashion

# Tono de voz de la marca
BRAND_VOICE=friendly, inspirational and authentic

# Nombre de tu marca (para el contexto del generador de contenido)
BRAND_NAME=Mi Marca
