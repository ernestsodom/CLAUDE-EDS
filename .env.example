# ─── Meta / Instagram ───────────────────────────────────────────
# Obtén estos valores en: https://developers.facebook.com/apps/
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_ig_business_account_id
INSTAGRAM_APP_ID=your_meta_app_id
INSTAGRAM_APP_SECRET=your_meta_app_secret

# ─── Anthropic / Claude ─────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Unsplash (búsqueda automática de imágenes) ─────────────────
# Gratis en: https://unsplash.com/developers (crea una app y copia el "Access Key")
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# ─── Zapier Webhook (para el bot autónomo) ──────────────────────
# Crea un Zap en zapier.com: Trigger = Webhooks > Catch Hook
# Action = Instagram for Business > Publish Photo
# Copia la URL del webhook aquí
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/XXXXXXX/XXXXXXX/

# ─── Horarios de publicación automática ─────────────────────────
# Formato: HH:MM separados por coma (hora local de tu PC)
POST_SCHEDULE=09:00,18:00

# ─── Comportamiento del bot ──────────────────────────────────────
DEFAULT_POST_FREQUENCY=2
BRAND_NICHE=fitness
BRAND_VOICE=motivador y apasionado
BRAND_NAME=Historias de Deporte
