@page "/login"
@layout AuthLayout
@inject AuthService AuthSvc
@inject NavigationManager Nav

<PageTitle>Iniciar Sesión — SistemaTickets</PageTitle>

<div class="login-header">
    <div class="login-logo">🎫</div>
    <h1>SistemaTickets</h1>
    <p>Plataforma de Soporte Técnico</p>
</div>

<EditForm Model="modelo" OnValidSubmit="HandleLogin" FormName="LoginForm">
    <DataAnnotationsValidator />

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-error">@error</div>
    }

    <div class="form-group">
        <label>Correo electrónico</label>
        <InputText @bind-Value="modelo.Correo" class="form-control" placeholder="correo@empresa.com" type="email" />
    </div>

    <div class="form-group">
        <label>Contraseña</label>
        <InputText @bind-Value="modelo.Password" class="form-control" placeholder="••••••••" type="password" />
    </div>

    <button type="submit" class="btn btn-primary btn-block" disabled="@cargando">
        @(cargando ? "Ingresando..." : "Ingresar")
    </button>
</EditForm>

@code {
    private LoginModel modelo = new();
    private string? error;
    private bool cargando;

    private async Task HandleLogin()
    {
        cargando = true;
        error = null;

        var ok = await AuthSvc.LoginAsync(modelo.Correo, modelo.Password);
        if (ok)
            Nav.NavigateTo("/", forceLoad: true);
        else
        {
            error = "Correo o contraseña incorrectos.";
            cargando = false;
        }
    }

    private class LoginModel
    {
        public string Correo { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
