@page "/clientes"
@attribute [Authorize]
@inject ClienteService ClienteSvc

<PageTitle>Clientes — SistemaTickets</PageTitle>

<div class="page-header">
    <h1>Clientes</h1>
    <a href="/clientes/nuevo" class="btn btn-primary">+ Nuevo Cliente</a>
</div>

@if (clientes.Count == 0)
{
    <div class="loading">Cargando...</div>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Nombre</th>
                <th>Empresa</th>
                <th>Correo</th>
                <th>Teléfono</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in clientes)
            {
                <tr class="@(c.Activo ? "" : "row-inactive")">
                    <td class="id-cell">@c.Id</td>
                    <td>@c.Nombre</td>
                    <td>@(c.Empresa ?? "—")</td>
                    <td>@(c.Correo ?? "—")</td>
                    <td>@(c.Telefono ?? "—")</td>
                    <td>
                        <span class="badge @(c.Activo ? "badge-open" : "badge-closed")">
                            @(c.Activo ? "Activo" : "Inactivo")
                        </span>
                    </td>
                    <td class="actions-cell">
                        <a href="/clientes/@c.Id" class="btn btn-sm">Editar</a>
                        <button class="btn btn-sm btn-danger" @onclick="() => ToggleActivo(c.Id)">
                            @(c.Activo ? "Desactivar" : "Activar")
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Cliente> clientes = [];

    protected override async Task OnInitializedAsync()
    {
        clientes = await ClienteSvc.ObtenerTodosAsync();
    }

    private async Task ToggleActivo(int id)
    {
        await ClienteSvc.ToggleActivoAsync(id);
        clientes = await ClienteSvc.ObtenerTodosAsync();
    }
}
