@page "/usuarios"
@attribute [Authorize(Roles = "Administrador")]
@inject UsuarioService UsuarioSvc

<PageTitle>Usuarios — SistemaTickets</PageTitle>

<div class="page-header">
    <h1>Usuarios</h1>
    <a href="/usuarios/nuevo" class="btn btn-primary">+ Nuevo Usuario</a>
</div>

@if (usuarios.Count == 0)
{
    <div class="loading">Cargando...</div>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Rol</th>
                <th>Estado</th>
                <th>Creado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in usuarios)
            {
                <tr class="@(u.Activo ? "" : "row-inactive")">
                    <td class="id-cell">@u.Id</td>
                    <td>@u.Nombre</td>
                    <td>@u.Correo</td>
                    <td><span class="badge badge-role">@u.Rol</span></td>
                    <td>
                        <span class="badge @(u.Activo ? "badge-open" : "badge-closed")">
                            @(u.Activo ? "Activo" : "Inactivo")
                        </span>
                    </td>
                    <td class="date-cell">@u.FechaCreacion.ToString("dd/MM/yy")</td>
                    <td class="actions-cell">
                        <a href="/usuarios/@u.Id" class="btn btn-sm">Editar</a>
                        <button class="btn btn-sm btn-danger" @onclick="() => ToggleActivo(u.Id)">
                            @(u.Activo ? "Desactivar" : "Activar")
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Usuario> usuarios = [];

    protected override async Task OnInitializedAsync()
    {
        usuarios = await UsuarioSvc.ObtenerTodosAsync();
    }

    private async Task ToggleActivo(int id)
    {
        await UsuarioSvc.ToggleActivoAsync(id);
        usuarios = await UsuarioSvc.ObtenerTodosAsync();
    }
}
