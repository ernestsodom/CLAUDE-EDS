# Cadena de conexión de Neon (Dashboard → Connect)
DATABASE_URL=postgresql://usuario:clave@host.neon.tech/neondb?sslmode=require
# Contraseña para entrar al back office (/admin)
ADMIN_PASSWORD=cambia-esta-clave
# Secreto para firmar las sesiones del back office (texto aleatorio largo)
SESSION_SECRET=texto-aleatorio-largo
