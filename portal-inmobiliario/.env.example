# ─── Portal Inmobiliario ────────────────────────────────────────
# Solo si el sitio pide iniciar sesión (p. ej. desde la nube): cookie de una
# sesión iniciada, formato "nombre=valor; nombre2=valor2". Obtenla con
# `python pi.py login` y `python pi.py exportar-sesion`. Es una credencial:
# en la nube defínela como secreto del entorno, nunca la subas al repositorio.
PI_COOKIES=

# Opcionales (tienen valores por defecto razonables):
# PI_SESION=./sesion_pi.json
# PI_PAUSA=3
# PI_MAX_PAGINAS=5
# PI_TIMEOUT=30
# PI_VALOR_UF=          # fija el valor UF en vez de consultar mindicador.cl
# PI_SALIDA_DIR=./salida
