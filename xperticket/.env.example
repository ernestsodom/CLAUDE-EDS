# --- Claude API (opcional, para narrativas de outreach con IA) ---
# Si no la defines, se usan narrativas de plantilla (deterministas).
ANTHROPIC_API_KEY=
XPERTI_CLAUDE_MODEL=claude-sonnet-4-6

# --- Web scraping (Módulo 2) ---
XPERTI_USER_AGENT=XperticketIntelBot/0.1 (+https://xperticket.cl; prospección comercial)
XPERTI_TIMEOUT=20
XPERTI_MAX_RETRIES=3
XPERTI_REQUEST_DELAY=1.0
# Poner 0 para ignorar robots.txt (NO recomendado).
XPERTI_RESPECT_ROBOTS=1
# Re-analizar prospectos con análisis más antiguo que N días.
XPERTI_REANALISIS_DIAS=45

# --- Conversión monetaria (Módulo 3) — ACTUALIZAR periódicamente ---
XPERTI_UF_CLP=39000
XPERTI_USD_CLP=960

# --- Almacenamiento ---
# XPERTI_DATA_DIR=/ruta/personalizada/data
